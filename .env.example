# ── Required ──────────────────────────────────────────────────────────

# Spring backend URL (scheme + host only, no trailing path)
NEXT_PUBLIC_API_ORIGIN=https://clawops.viksi.ai

# The single email address allowed to access the chat app
ALLOWED_EMAIL=user@gmail.com

# ── Optional ──────────────────────────────────────────────────────────

# Server port (default: 3100)
# PORT=3100

# HMAC key for signing session cookies (auto-generated if not set)
# SESSION_SECRET=

# Working directory for the Claude agent (default: /root)
# CLAUDE_CWD=/root

# Comma-separated allowed WebSocket origins (dev mode allows all)
# ALLOWED_ORIGINS=https://viksi.ai,https://chat.viksi.ai

# Permission/question response timeout in ms (default: 300000 = 5 min)
# RESPONSE_TIMEOUT_MS=300000

# Max WebSocket messages per second per session (default: 20)
# WS_RATE_LIMIT=20

# Next.js base path (default: /chat)
# NEXT_PUBLIC_BASE_PATH=/chat
