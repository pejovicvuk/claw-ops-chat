# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Compiled artifacts produced by `npm run dev`'s tsc call. Server.ts is
# the intended output (plus bitbucket-mcp.js) but tsc also dumps .js
# beside every .ts it pulls in transitively. These .js shadow the .ts
# at vitest resolution time (bundler prefers .js when both exist) and
# break the reports test suite. Keep the hand-maintained .js mirrors
# (auth-server.js, session-persistence.js, etc.) — they're tracked
# deliberately because the compiled server.js requires() them.
src/lib/agent-config.js
src/lib/bitbucket-custom-config.js
src/lib/reports/*.js
src/lib/monitoring/**/*.js
src/lib/audit/*.js
src/app/api/monitoring/**/*.js
src/components/monitoring/**/*.js

# Claude Code local settings (not shared)
.claude/settings.local.json
.claude/agent-memory-local/
