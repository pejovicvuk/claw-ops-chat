{
  "name": "claw-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc server.ts --outDir . --esModuleInterop --module commonjs --target ES2020 --skipLibCheck && node server.js",
    "dev:tsx": "tsx server.ts",
    "dev:next": "next dev",
    "build": "next build && tsc server.ts --outDir . --esModuleInterop --module commonjs --target ES2020 --skipLibCheck",
    "start": "node server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@types/react-window": "^1.8.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "lightningcss": "^1.32.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "node-pty": "^1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-window": "^2.2.7",
    "remark-gfm": "^4.0.1",
    "ws": "^8.20.0"
