# Copy this file to `.env` (same directory as docker-compose.yml) before
# running `docker compose up -d`.

# ── Required ──────────────────────────────────────────────────────────

# Spring backend URL the browser talks to (scheme + host, no trailing path).
NEXT_PUBLIC_API_ORIGIN=https://your.backend.example.com

# The single email address allowed to sign in.
ALLOWED_EMAIL=you@example.com

# HMAC key used to sign session cookies. Generate a long random string, e.g.:
#   openssl rand -hex 48
SESSION_SECRET=replace-me-with-a-long-random-string

# Comma-separated list of allowed WebSocket origins. In production this MUST
# match the public URL the browser uses to reach the app.
ALLOWED_ORIGINS=https://your.public.domain.tld

# ── Optional ──────────────────────────────────────────────────────────

# Internal container port (nginx upstream points here — usually no reason to change).
# PORT=3100

# Working directory for the Claude agent (mounted from the host in docker-compose.yml).
# CLAUDE_CWD=/root

# Response timeout for Claude permission/tool prompts, in ms (default 5 min).
# RESPONSE_TIMEOUT_MS=300000

# Max WebSocket messages per second per session (default 20).
# WS_RATE_LIMIT=20

# Base path under which the app is served (default /chat).
# NEXT_PUBLIC_BASE_PATH=/chat

# Kill-switch for the in-browser Terminal page. Set to 1 to disable.
# DISABLE_TERMINAL=0

# Override the shell spawned by the Terminal page.
#   Linux container default: /bin/bash
#   Examples: /bin/sh, /bin/zsh (if installed)
# CLAUDE_TERMINAL_SHELL=/bin/bash
